# Αντέγραψε σε config.env και συμπλήρωσε:  cp config.env.example config.env
# Το config.env ΔΕΝ ανεβαίνει στο git (.gitignore).

# --- Vast.ai ---------------------------------------------------------------
# Από https://cloud.vast.ai/account/  -> API Keys
VAST_API_KEY=

# Φίλτρο αναζήτησης GPU (σύνταξη vastai search offers).
# 24GB κάρτα (RTX 4090 / 3090) αρκεί για μοντέλα έως ~14B (ή ~32B quantized).
GPU_QUERY='gpu_name in [RTX_4090,RTX_3090] num_gpus=1 reliability>0.98 cuda_vers>=12.4 inet_down>=300 direct_port_count>=2 disk_space>=80 rentable=true verified=true'

# Χώρος δίσκου στο instance σε GB (βάρη μοντέλων + cache)
DISK_GB=80

# Προαιρετικό label για να ξεχωρίζεις το instance στο dashboard
INSTANCE_LABEL=aipan

# --- Μοντέλο (profile: vllm) ---------------------------------------------
# Οποιοδήποτε μοντέλο του Hugging Face που υποστηρίζει το vLLM
MODEL=Qwen/Qwen3-8B
MAX_MODEL_LEN=16384
VLLM_IMAGE=vllm/vllm-openai:latest
# Χρειάζεται μόνο για gated μοντέλα (π.χ. Llama). https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Ασφάλεια --------------------------------------------------------------
# Το κλειδί που θα στέλνουν οι εφαρμογές σου (Authorization: Bearer ...).
# Άφησέ το κενό και το launch.sh θα δημιουργήσει ένα τυχαίο.
API_KEY=

# --- Profile: coding (Claude Code / coding agents) ------------------------
# Qwen3-Coder-Next: 80B MoE (3B active), 256K context, native tool calling.
# Σε FP8 τα βάρη είναι ~80GB, οπότε θέλει κάρτα 96GB+ (RTX PRO 6000 / H200).
CODING_MODEL=Qwen/Qwen3-Coder-Next-FP8
CODING_GPU_QUERY='gpu_ram>=94 num_gpus=1 reliability>0.98 cuda_vers>=12.8 inet_down>=1000 direct_port_count>=2 disk_space>=200 rentable=true verified=true'
CODING_DISK_GB=200
CODING_MAX_MODEL_LEN=131072
TOOL_CALL_PARSER=qwen3_coder
# Φθηνότερη εναλλακτική (48GB κάρτα, π.χ. A6000 / L40S, ~0.4-0.8$/h):
#   CODING_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8
#   CODING_GPU_QUERY='gpu_ram>=45 num_gpus=1 reliability>0.98 cuda_vers>=12.8 inet_down>=500 direct_port_count>=2 disk_space>=120 rentable=true verified=true'
#   CODING_DISK_GB=120
#   CODING_MAX_MODEL_LEN=65536

# --- Profile: webui (Open WebUI + Ollama) ---------------------------------
WEBUI_IMAGE=ghcr.io/open-webui/open-webui:ollama
